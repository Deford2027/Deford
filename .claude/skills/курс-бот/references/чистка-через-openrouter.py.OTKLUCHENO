#!/usr/bin/env python3
"""
Чистка расшифровок курсов в конспекты для базы знаний.
Промпт и модель — те же, что в рабочем CourseBot (проверены боем).

  python3 чистка.py --папка "…/SEO Мясо" --тест 3      # проверить на трёх
  python3 чистка.py --папка "…/SEO Мясо"               # прогнать всё
"""
import argparse, concurrent.futures, glob, json, os, re, sys, time, urllib.request

МОДЕЛЬ = "anthropic/claude-sonnet-5"     # 24 прогона: 100% инструментов, ни одного провала
ЦЕНА_ВХ, ЦЕНА_ВЫХ = 2.00, 10.00          # $/1М

# ДВА ПРОХОДА. Замер 10.09.2026, 8 уроков x 2 повтора, claude-sonnet-5:
#   один проход без структуры  - 95% значений, нижняя граница 86%, 0 заголовков
#   ДВА ПРОХОДА (этот вариант) - 99% значений, нижняя граница 89%, 14 заголовков
# Структура НЕ стоит потери конкретики, если РАЗДЕЛИТЬ операции. Пока модель
# одновременно чистит и структурирует, она переходит в режим пересказа и теряет
# треть деталей. Разделённые проходы дают и структуру, и полноту.
ПРОХОД_1 = 'Ты — редактор транскриптов для базы знаний.\n\nЗадача: очистить текст урока, но НЕ пересказывать его.\nСохраняй дословно все смысловые фразы, термины, формулировки, числа, даты, имена, примеры, определения, оговорки и логический порядок.\nУдаляй только мусор: рекламу, повторы, междометия, сбои распознавания, обрывки речи, слова-паразиты, служебные вставки, технический шум.\nЕсли фрагмент содержит полезный смысл, оставь его дословно.\nЕсли сомневаешься, сохраняй фрагмент, а не выкидывай его.\nНельзя: перефразировать, упрощать, обобщать, объединять мысли, менять порядок фактов, добавлять выводы, исправлять стиль, заменять авторские слова своими.\nНа выходе дай только очищенный текст, без комментариев, без заголовков, без пояснений.\n\n**'

ПРОХОД_2 = 'Ты — редактор структуры для базы знаний.\n\nТебе дан очищенный текст после первого прохода.\nТвоя задача: добавить структуру МЕТОДИЧКИ, НЕ ИЗМЕНЯЯ НИ ОДНОГО СЛОВА ВНУТРИ ПРЕДЛОЖЕНИЙ.\nРазрешено только:\n- ставить заголовки;\n- разбивать текст на разделы и абзацы;\n- переносить уже существующие предложения под подходящие заголовки;\n- добавлять нумерацию разделов;\n- оставлять текст дословно.\n\nЗапрещено:\n- перефразировать;\n- сокращать;\n- дополнять;\n- объединять;\n- переставлять слова внутри предложений;\n- менять терминологию;\n- исправлять стиль;\n- делать выводы от себя.\n\nПравило: каждое предложение должно остаться в исходной формулировке.\nЕсли для структурирования не хватает данных, не додумывай и не пересказывай — просто оставь текст как есть под ближайшим подходящим заголовком.\n\nСделай структуру методички с логичными разделами, но текст внутри разделов оставь дословным.\nНа выходе дай только структурированный текст, без комментариев.'


def баланс(key):
    """Остаток на ключе. Не запускать прогон, которому не хватит денег."""
    req = urllib.request.Request("https://openrouter.ai/api/v1/credits",
                                 headers={"Authorization": "Bearer " + key})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            d = (json.loads(r.read()) or {}).get("data") or {}
        return float(d.get("total_credits", 0)) - float(d.get("total_usage", 0))
    except Exception:
        return None


def оценить(файлы):
    """Ожидаемая стоимость прогона. Два прохода: вход дважды, выход дважды.
    Замер 10.09.2026: реальная цена вышла на четверть выше расчётной по знакам,
    поэтому коэффициент 1.25 — лучше переоценить, чем внезапно уйти в минус."""
    знаков = 0
    for f in файлы:
        try:
            t = open(f, encoding="utf-8", errors="replace").read()
        except Exception:
            continue
        if "## Расшифровка видео" in t:
            знаков += len(t.split("## Расшифровка видео", 1)[1].split("\n## ")[0])
    вх = знаков / 3.5
    return ((вх * 2) * ЦЕНА_ВХ + (вх * 1.9) * ЦЕНА_ВЫХ) / 1e6 * 1.25


def ключ():
    p = os.path.expanduser("~/.claude/secrets/openrouter.key")
    return open(p).read().strip() if os.path.exists(p) else os.environ.get("OPENROUTER_API_KEY", "")


def проход(key, промпт, текст, лимит):
    body = json.dumps({"model": МОДЕЛЬ,
        "messages": [{"role": "user", "content": промпт + "\n\n" + текст}],
        "max_tokens": лимит, "transforms": []}).encode()
    req = urllib.request.Request("https://openrouter.ai/api/v1/chat/completions", data=body,
        headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=900) as r:
        d = json.loads(r.read())
    if d.get("error"):
        return "", 0.0, str(d["error"])[:120]
    ch = (d.get("choices") or [{}])[0]
    u = d.get("usage") or {}
    цена = (u.get("prompt_tokens", 0) * ЦЕНА_ВХ + u.get("completion_tokens", 0) * ЦЕНА_ВЫХ) / 1e6
    txt = (ch.get("message") or {}).get("content") or ""
    беда = "обрыв по лимиту" if ch.get("finish_reason") == "length" else ""
    return txt, цена, беда


def обработать(args):
    key, путь = args
    t = open(путь, encoding="utf-8", errors="replace").read()
    if "## Расшифровка видео" not in t:
        return путь, 0.0, "нет расшифровки"
    вых = путь.replace("/SEO Мясо/", "/SEO Мясо (чистое)/")
    if os.path.exists(вых) and os.path.getsize(вых) > 400:
        return путь, 0.0, "уже готов"
    загол = t.split("\n", 1)[0].lstrip("# ").strip()
    рас = t.split("## Расшифровка видео", 1)[1].split("\n## ")[0].strip()
    if len(рас) < 200:
        return путь, 0.0, "слишком коротко"
    цена, беда = 0.0, ""
    тек = рас
    for пром in (ПРОХОД_1, ПРОХОД_2):
        лимит = min(max(8000, int(len(тек) / 1.5)), 32000)
        тек, ц, б = проход(key, пром, тек, лимит)
        цена += ц
        if б: беда = б
        if not тек.strip():
            return путь, цена, беда or "пусто после прохода"
    конспект = тек

    if not конспект.strip():
        return путь, цена, беда or "пусто"
    # хвост исходника (описание/задания/файлы) сохраняем как есть
    хвост = ""
    for разд in ("## Задания", "## Файлы"):
        if разд in t:
            хвост += "\n\n" + разд + t.split(разд, 1)[1].split("\n## ")[0].rstrip()
    os.makedirs(os.path.dirname(вых), exist_ok=True)
    open(вых, "w", encoding="utf-8").write(f"# {загол}\n\n{конспект.strip()}{хвост}\n")
    return путь, цена, беда


СТОП = {"причина": ""}


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--папка", required=True)
    ap.add_argument("--тест", type=int, default=0)
    ap.add_argument("--потоков", type=int, default=6)
    ap.add_argument("--бюджет", type=float, default=5.0,
                    help="потолок трат на прогон, $; превышение — остановка")
    ap.add_argument("--да", action="store_true",
                    help="согласиться на прогон дороже бюджета")
    a = ap.parse_args()

    key = ключ()
    if not key:
        sys.exit("нет ключа OpenRouter")
    файлы = sorted(f for f in glob.glob(os.path.join(a.папка, "*", "*.md"))
                   if "_КУРС_целиком" not in f)
    if a.тест:
        файлы = файлы[:a.тест]
    # ── ПРЕДОХРАНИТЕЛЬ ПО БЮДЖЕТУ ──
    ожидание = оценить(файлы)
    ост = баланс(key)
    print(f"файлов к обработке: {len(файлы)}")
    print(f"ожидаемая стоимость: ~${ожидание:.2f}   бюджет: ${a.бюджет:.2f}")
    if ост is not None:
        print(f"на ключе сейчас: ${ост:.2f}")
        if ост < ожидание:
            sys.exit(f"СТОП: на ключе ${ост:.2f}, а нужно ~${ожидание:.2f}. "
                     f"Пополнить или обработать часть файлов.")
    if ожидание > a.бюджет and not a.да:
        sys.exit(f"СТОП: прогон дороже бюджета (${ожидание:.2f} > ${a.бюджет:.2f}).\n"
                 f"Поднять потолок: --бюджет {max(ожидание*1.2, 0.01):.2f}   или согласиться: --да\n"
                 f"Дешевле: меньше файлов за раз, либо модель попроще "
                 f"(см. references — gemini-2.5-flash в 9 раз дешевле).")
    t0, всего, ошибок, готово = time.time(), 0.0, 0, 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=a.потоков) as ex:
        for i, (п, ц, беда) in enumerate(ex.map(обработать, [(key, f) for f in файлы]), 1):
            всего += ц
            if всего > a.бюджет and not СТОП["причина"]:
                СТОП["причина"] = f"бюджет ${a.бюджет:.2f} исчерпан"
                print(f"\n⛔ СТОП: потрачено ${всего:.2f}, бюджет ${a.бюджет:.2f}. "
                      f"Останавливаюсь, обработано {i} из {len(файлы)}.")
                break
            if беда and беда not in ("уже готов", "нет расшифровки"):
                ошибок += 1
                print(f"  ⚠ {os.path.basename(п)[:50]} — {беда}")
            elif not беда:
                готово += 1
            if i % 25 == 0:
                print(f"  {i}/{len(файлы)}  ${всего:.3f}  {time.time()-t0:.0f}с")
    print(f"\nготово: {готово}, ошибок: {ошибок}, потрачено ${всего:.3f}, "
          f"время {time.time()-t0:.0f}с")
